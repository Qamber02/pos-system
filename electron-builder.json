{
  "appId": "com.pos.shopping",
  "productName": "POS Shopping",
  "executableName": "POS-Shopping",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*"
  ],
  "win": {
    "target": [
      "portable",
      "zip"
    ],
    "icon": "src/assets/app-icon.png",
    "signAndEditExecutable": false
  },
  "mac": {
    "target": "dmg",
    "icon": "src/assets/app-icon.png"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "src/assets/app-icon.png",
    "category": "Office"
  }
}
